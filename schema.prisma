generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String   @id @default(cuid())
  name      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  uploadedImage   String
  selectedDesign  String   // JSON string of selected design
  tapeWidth       String
  tapeLength      Float    @default(10) // meters
  finish          String
  quantity        Int      @default(1)
  price           Float
  paymentStatus   String   @default("PENDING") // PENDING, PAID_DEMO, PAID
  paymentId       String?
  productionStatus String  @default("ORDER_RECEIVED")
  shippingStatus  String   @default("NOT_SHIPPED")
  printFilePath   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  printJobs       PrintJob[]
}

model PrintJob {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  filePath    String
  printerType String   @default("DemoA4")
  status      String   @default("QUEUED") // QUEUED, PRINTING, COMPLETED, FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DesignSuggestion {
  id          String   @id @default(cuid())
  orderId     String?
  name        String
  colors      String   // JSON
  description String
  matchingScore Float
  recommendedWidth String
  finish      String
  patternType String
  previewData String?  // SVG or base64
  createdAt   DateTime @default(now())
}
